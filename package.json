{
  "name": "lws",
  "author": "Lloyd Brookes <75pound@gmail.com>",
  "version": "4.1.4",
  "description": "A lean, modular web server for rapid full-stack development",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lwsjs/lws.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "lws": "bin/cli.js"
  },
  "exports": {
    ".": "./index.js"
  },
  "keywords": [
    "lws",
    "server",
    "http",
    "http2",
    "https",
    "backend",
    "http-server",
    "dev",
    "web"
  ],
  "engines": {
    "node": ">=12.20"
  },
  "scripts": {
    "test": "test-runner test/*.js test/internals/*.js"
  },
  "files": [
    "index.js",
    "ssl",
    "lib",
    "bin"
  ],
  "dependencies": {
    "command-line-args": "github:75lb/command-line-args#next",
    "current-module-paths": "^1.1.2",
    "express": "^5.1.0",
    "morgan": "^1.10.1",
    "serve-index": "^1.9.1"
  },
  "peerDependencies": {
    "@75lb/nature": "latest"
  },
  "peerDependenciesMeta": {
    "@75lb/nature": {
      "optional": true
    }
  },
  "standard": {
    "ignore": [
      "tmp",
      "dist"
    ],
    "envs": []
  }
}
